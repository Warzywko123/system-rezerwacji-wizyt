# Lokalnie: baza PGlite w katalogu projektu (bez instalowania Postgresa).
PGLITE_DIR=.pglite
# Produkcja (Vercel): adres bazy Neon zamiast PGLITE_DIR.
# DATABASE_URL=postgresql://...
# Jednorazowo przy pierwszym wdrożeniu: tworzy tabele w pustej bazie Neon.
# MIGRATE=1

# Hasło do panelu (wspólne dla recepcjonisty i doktora).
ADMIN_PASSWORD=zmien-mnie
# Sekret 2FA — wygeneruj: npm run totp
ADMIN_TOTP_SECRET=
# Losowy ciąg (min. 32 znaki) do podpisu sesji i pseudonimizacji IP.
SESSION_SECRET=
# Sekret zaplanowanego zadania czyszczącego dane (Vercel Cron).
CRON_SECRET=
# Numer gabinetu pokazywany klientom.
GABINET_TELEFON=600 000 000
